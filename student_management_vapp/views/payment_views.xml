<odoo>

    <!-- FORM -->
    <record id="view_payment_form" model="ir.ui.view">
        <field name="name">payment.form</field>
        <field name="model">student.payment</field>
        <field name="arch" type="xml">
            <form string="Payment">
                <sheet>
                    <group>
                        <field name="student_id"/>
                        <field name="amount"/>
                        <field name="payment_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST -->
    <record id="view_payment_list" model="ir.ui.view">
        <field name="name">payment.list</field>
        <field name="model">student.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="amount"/>
                <field name="payment_date"/>
            </list>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">student.payment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_payment" name="Payments"
        parent="menu_student_root"
        action="action_payment"/>

</odoo>