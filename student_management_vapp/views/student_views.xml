
<odoo>

    <!-- 🔹 FORM VIEW -->
    <record id="view_student_form" model="ir.ui.view">
        <field name="name">student.form</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <form string="Student Details">
                <sheet>

                    <group>
                        <field name="student_code"/>
                        <field name="name"/>
                        <field name="age"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="course"/>
                        <field name="status" widget="badge"/>
                    </group>

                    <group string="Fees Details">
                        <field name="fees_total"/>
                        <field name="fees_paid"/>
                        <field name="fees_due" readonly="1"/>
                        <field name="payment_status" widget="badge"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- 🔹 LIST VIEW -->
    <record id="view_student_tree" model="ir.ui.view">
        <field name="name">student.tree</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_code"/>
                <field name="name"/>
                <field name="email"/>
                <field name="course"/>
                <field name="fees_total"/>
                <field name="fees_due"/>
                <field name="payment_status" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- 🔍 SEARCH VIEW -->
    <record id="view_student_search" model="ir.ui.view">
        <field name="name">student.search</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <search string="Search Students">
                <field name="name"/>
                <field name="course"/>

                <separator/>

                <filter name="paid_filter" string="Paid"
                    domain="[('payment_status','=','paid')]"/>

                <filter name="unpaid_filter" string="Unpaid"
                    domain="[('payment_status','=','unpaid')]"/>
            </search>
        </field>
    </record>

    <!-- 🔹 ACTION -->
    <record id="action_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">student.student</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- 🔹 MENU -->
    <menuitem id="menu_student_root" name="Student Management"/>
    <menuitem id="menu_student" name="Students" parent="menu_student_root" action="action_student"/>

</odoo>
